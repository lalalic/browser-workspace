#!/bin/sh
set -eu
SOURCE=$0
while [ -L "$SOURCE" ]; do
  PARENT=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd -P)
  TARGET=$(readlink "$SOURCE")
  case "$TARGET" in /*) SOURCE=$TARGET ;; *) SOURCE="$PARENT/$TARGET" ;; esac
done
SKILL_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")/.." && pwd -P)
export WEBHELM_PLATFORM_DIR="${WEBHELM_PLATFORM_DIR:-$SKILL_DIR/platforms}"
if [ -f "$SKILL_DIR/../../src/cli.mjs" ]; then
  exec node "$SKILL_DIR/../../src/cli.mjs" "$@"
fi
exec npx --yes --package webhelm webhelm "$@"
