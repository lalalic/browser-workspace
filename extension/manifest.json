{
  "manifest_version": 3,
  "name": "Browser Workspace",
  "version": "0.2.2",
  "description": "Own named Chrome tab-group workspaces and exact-size reusable tab pools for browser agents.",
  "key": "",
  "permissions": ["storage", "tabs", "tabGroups"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  }
}
