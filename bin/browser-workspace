#!/usr/bin/env python3
from __future__ import annotations
import argparse, json, sys
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
from session_client import request
from platform_runner import run_platform_action

def emit(x): print(json.dumps(x,ensure_ascii=False))

def _workspace_command(argv):
    if not argv:
        raise SystemExit('usage: browser-workspace workspace {create,delete} ...')
    cmd=argv[0]
    if cmd=='create':
        parser=argparse.ArgumentParser(prog='browser-workspace workspace create', add_help=False)
        parser.add_argument('name')
        parser.add_argument('--size', type=int, default=5)
        args=parser.parse_args(argv[1:])
        if args.size < 1:
            parser.error('--size must be at least 1')
        r=request({'op':'workspace-create','name':args.name,'pool_size':args.size})
    elif cmd=='delete':
        parser=argparse.ArgumentParser(prog='browser-workspace workspace delete', add_help=False)
        parser.add_argument('name')
        parser.add_argument('--force', action='store_true')
        args=parser.parse_args(argv[1:])
        r=request({'op':'workspace-delete','name':args.name,'force':args.force})
    else:
        raise SystemExit(f'unknown workspace command: {cmd}')
    emit(r)
    if r.get('error'):
        raise SystemExit(1)

def main():
    # Hidden product-facing lifecycle group for product/runtime integrations.
    # It is intentionally handled before argparse so normal agent help does not
    # advertise workspace management commands.
    if len(sys.argv) >= 2 and sys.argv[1] == 'workspace':
        _workspace_command(sys.argv[2:])
        return
    p=argparse.ArgumentParser(prog='browser-workspace')
    sp=p.add_subparsers(dest='group',required=True)
    session=sp.add_parser('session'); ssp=session.add_subparsers(dest='cmd',required=True)
    start=ssp.add_parser('start'); start.add_argument('--workspace', help=argparse.SUPPRESS); start.add_argument('--url')
    ex=ssp.add_parser('exec'); ex.add_argument('session_id'); ex.add_argument('--code-file')
    stop=ssp.add_parser('stop'); stop.add_argument('session_id')
    platform=sp.add_parser('platform'); psp=platform.add_subparsers(dest='pcmd',required=True)
    profile=psp.add_parser('profile'); profile.add_argument('platform')
    run=psp.add_parser('run'); run.add_argument('platform'); run.add_argument('action'); run.add_argument('--config'); run.add_argument('--url')
    args=p.parse_args()
    if args.group=='session' and args.cmd=='start': emit(request({'op':'start','workspace':args.workspace,'url':args.url})); return
    if args.group=='session' and args.cmd=='exec':
        if args.code_file: code=Path(args.code_file).read_text()
        elif not sys.stdin.isatty(): code=sys.stdin.read()
        else: p.error('session exec reads Python from stdin (use a heredoc) or --code-file')
        r=request({'op':'exec','session_id':args.session_id,'code':code}); emit(r); raise SystemExit(0 if r.get('ok',False) else 1)
    if args.group=='session' and args.cmd=='stop': emit(request({'op':'stop','session_id':args.session_id})); return
    if args.group=='platform' and args.pcmd=='profile':
        from platform_runner import platform_profile
        emit(platform_profile(args.platform)); return
    if args.group=='platform' and args.pcmd=='run':
        r=run_platform_action(args.platform,args.action,config_path=args.config,url=args.url); emit(r); raise SystemExit(0 if (r.get('result') or {}).get('ok',False) else 1)
if __name__=='__main__': main()
